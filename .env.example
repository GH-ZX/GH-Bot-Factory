# Application
APP_ENV=development
APP_NAME=gh-bot-factory
LOG_LEVEL=INFO

# Database
POSTGRES_DB=gh_bot_factory
POSTGRES_USER=gh_bot_factory
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://gh_bot_factory:CHANGE_ME@postgres:5432/gh_bot_factory

# Redis
REDIS_URL=redis://redis:6379/0

# Telegram
# Never commit real bot tokens.
TELEGRAM_BOT_TOKEN=

# Security
SECRET_KEY=CHANGE_ME
