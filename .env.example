# Application
APP_ENV=development
APP_NAME=gh-bot-factory
LOG_LEVEL=INFO

# Database
POSTGRES_DB=gh_bot_factory
POSTGRES_USER=gh_bot_factory
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://gh_bot_factory:CHANGE_ME@postgres:5432/gh_bot_factory

# Redis
REDIS_URL=redis://redis:6379/0

# Telegram
# Never commit real bot tokens. Bot.token_secret_ref may point at this variable.
TELEGRAM_BOT_TOKEN=
# Example additional secret reference used by the Bot Factory wizard:
# FIRST_TRIAL_TELEGRAM_BOT_TOKEN=<BotFather-token>

# Public HTTPS URL served to Telegram clients. Example:
# MINIAPP_PUBLIC_URL=https://shop.example.com/miniapp/
# Telegram WebAppInfo requires HTTPS. Leave blank to keep legacy bot menus only.
MINIAPP_PUBLIC_URL=
# Admin Web App URL, normally the same public host with /admin/.
ADMIN_PUBLIC_URL=
MINIAPP_MENU_TEXT=Open Store
BOT_RUNTIME_RECONCILE_SECONDS=5
BOT_RUNTIME_RELEASE_CHANNELS=STABLE,CANARY
FACTORY_MAX_BOTS_PER_TENANT=50
FACTORY_MAX_ENABLED_BOTS_PER_TENANT=20
FACTORY_MAX_OPEN_PROVISIONING_JOBS_PER_TENANT=10

# Security
# Generate JWT_SECRET_KEY with a cryptographically secure random generator, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank until configured; the API refuses to create an AuthTokenService without it.
JWT_SECRET_KEY=
SECRET_KEY=

# Production hardening
# Production/staging startup fails closed unless these are enabled.
LOG_JSON=true
MAX_REQUEST_BODY_BYTES=1048576
HEALTH_DEPENDENCY_TIMEOUT_SECONDS=2
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_MONEY_PER_MINUTE=20
RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=60
# In production/staging set RATE_LIMIT_ENABLED=true and RATE_LIMIT_BACKEND=redis.
# Trust only the reverse proxy network/address that injects X-Forwarded-* headers.
FORWARDED_ALLOW_IPS=127.0.0.1

# Backup policy
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_RECIPIENT=
ALLOW_UNENCRYPTED_BACKUPS=false

# First-run web installer / self-hosted local vault
# scripts/easy_start.py generates SETUP_CODE automatically when missing.
SETUP_CODE=
LOCAL_SECRET_VAULT_ENABLED=true
LOCAL_SECRET_VAULT_DIR=/var/lib/ghbf/secret-store
API_HOST_PORT=8010
