# Application
APP_ENV=development
APP_NAME=gh-bot-factory
LOG_LEVEL=INFO

# Database
POSTGRES_DB=gh_bot_factory
POSTGRES_USER=gh_bot_factory
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://gh_bot_factory:CHANGE_ME@postgres:5432/gh_bot_factory

# Redis
REDIS_URL=redis://redis:6379/0

# Telegram
# Never commit real bot tokens. Bot.token_secret_ref may point at this variable.
TELEGRAM_BOT_TOKEN=
# Example additional secret reference used by the Bot Factory wizard:
# FIRST_TRIAL_TELEGRAM_BOT_TOKEN=<BotFather-token>

# Public HTTPS URL served to Telegram clients. Example:
# MINIAPP_PUBLIC_URL=https://shop.example.com/miniapp/
# Telegram WebAppInfo requires HTTPS. Leave blank to keep legacy bot menus only.
MINIAPP_PUBLIC_URL=
# Admin Web App URL, normally the same public host with /admin/.
ADMIN_PUBLIC_URL=
MINIAPP_MENU_TEXT=Open Store
BOT_RUNTIME_RECONCILE_SECONDS=5
BOT_RUNTIME_RELEASE_CHANNELS=STABLE,CANARY
FACTORY_MAX_BOTS_PER_TENANT=50
FACTORY_MAX_ENABLED_BOTS_PER_TENANT=20
FACTORY_MAX_OPEN_PROVISIONING_JOBS_PER_TENANT=10

# Security
# Generate JWT_SECRET_KEY with a cryptographically secure random generator, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank until configured; the API refuses to create an AuthTokenService without it.
JWT_SECRET_KEY=
SECRET_KEY=

# Production hardening
# Production/staging startup fails closed unless these are enabled.
LOG_JSON=true
MAX_REQUEST_BODY_BYTES=1048576
HEALTH_DEPENDENCY_TIMEOUT_SECONDS=2
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_MONEY_PER_MINUTE=20
RATE_LIMIT_ADMIN_WRITE_PER_MINUTE=60
# In production/staging set RATE_LIMIT_ENABLED=true and RATE_LIMIT_BACKEND=redis.
# Trust only the reverse proxy network/address that injects X-Forwarded-* headers.
FORWARDED_ALLOW_IPS=127.0.0.1

# Backup policy
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_GPG_RECIPIENT=
ALLOW_UNENCRYPTED_BACKUPS=false

# First-run web installer / self-hosted local vault
# scripts/easy_start.py generates SETUP_CODE automatically when missing.
SETUP_CODE=
# Local/VPS operator boundary for /api/v1/platform/* and scripts/platformctl.py.
# scripts/easy_start.py generates a strong value automatically.
PLATFORM_ADMIN_TOKEN=

# Optional hosted SaaS billing. Keep disabled for laptop-only/self-hosted operation.
# Stripe credentials remain environment/vault-owned and are never persisted in the database.
BILLING_PROVIDER=disabled
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
BILLING_PORTAL_RETURN_URL=
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_RECONCILE_ENABLED=true
BILLING_RECONCILE_INTERVAL_SECONDS=900
BILLING_RECONCILE_BATCH_SIZE=200
BILLING_SYNC_STALE_SECONDS=86400
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

LOCAL_SECRET_VAULT_ENABLED=true
LOCAL_SECRET_VAULT_DIR=/var/lib/ghbf/secret-store
API_BIND_ADDRESS=0.0.0.0
API_HOST_PORT=8010

# Laptop/VPS portable state bundles
PORTABLE_EXPORT_DIR=./portable-exports
PORTABLE_GPG_RECIPIENT=
# Portable bundles include the vault master key; plaintext export requires explicit opt-in.
ALLOW_PLAINTEXT_PORTABLE_EXPORT=false

# External supplier/provider adapters
# Generic HTTP/OpenAPI adapters reject private/reserved targets by default.
PROVIDER_HTTP_ALLOW_PRIVATE_NETWORKS=false
# Production/staging requires Generic HTTP target hosts to be explicitly allowlisted.
# Comma-separated exact hosts or wildcard subdomains, e.g. api.vendor.tld,*.vendor.tld
PROVIDER_HTTP_ALLOWED_HOSTS=
# Lifetime of normalized provider offer observations before routing treats them as stale/advisory.
PROVIDER_OFFER_FRESHNESS_SECONDS=300
# Pull reconciliation keeps accepted/pending provider orders convergent without public webhooks.
PROVIDER_RECONCILE_ENABLED=true
PROVIDER_RECONCILE_INTERVAL_SECONDS=30
PROVIDER_RECONCILE_BATCH_SIZE=200

# Phase 11 payment evidence reconciliation. Worker only activates when a trusted
# chain verifier adapter is registered by the application.
# Provider-backed payment pull reconciliation (works without public webhooks)
PAYMENT_PROVIDER_RECONCILE_ENABLED=true
PAYMENT_PROVIDER_RECONCILE_INTERVAL_SECONDS=30
PAYMENT_PROVIDER_RECONCILE_BATCH_SIZE=100
PAYMENT_OPERATIONS_STALE_SECONDS=900

PAYMENT_ONCHAIN_RECONCILE_ENABLED=true
PAYMENT_ONCHAIN_RECONCILE_INTERVAL_SECONDS=30
PAYMENT_ONCHAIN_RECONCILE_BATCH_SIZE=100

# Trusted TRON USDt verifier. Disabled until the installation owner opts in.
# Token identity is fixed to Tether's official TRON USDt contract in code.
PAYMENT_TRON_USDT_ENABLED=false
PAYMENT_TRONGRID_BASE_URL=https://api.trongrid.io
PAYMENT_TRONGRID_API_KEY=
PAYMENT_TRON_TIMEOUT_SECONDS=12

# Optional generic BSC ERC-20 verifier. There is intentionally NO built-in "USDT BEP20"
# assumption: configure the exact contract, decimals and internal asset identity you accept.
PAYMENT_BSC_TOKEN_ENABLED=false
PAYMENT_BSC_RPC_URL=
PAYMENT_BSC_TOKEN_ASSET=
PAYMENT_BSC_TOKEN_CONTRACT=
PAYMENT_BSC_TOKEN_DECIMALS=18
PAYMENT_BSC_CHAIN_ID=56
PAYMENT_BSC_TIMEOUT_SECONDS=12
